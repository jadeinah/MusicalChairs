local makeHttpRequest = request or http_request or (http and http.request) or fluxus or (syn and syn.request)

local function safeFind(parent, ...)
    local current = parent
    for _, name in ipairs({...}) do
        current = current and current:FindFirstChild(name)
        if not current then return nil end
    end
    return current
end

-- ==========================================
-- 🖱️ HUMANIZED VIM CLICKER & HELPERS
-- ==========================================
local function randomDelay(minMs, maxMs)
    task.wait(math.random(minMs, maxMs) / 1000)
end

local function SafeVIMClick(button)
    if not button then return false end
    
    local screenGui = button:FindFirstAncestorWhichIsA("ScreenGui")
    local origDisplayOrder = screenGui and screenGui.DisplayOrder or 0
    local origZIndex = button.ZIndex

    if screenGui then screenGui.DisplayOrder = 999999 end
    button.ZIndex = 999999

    local pos = button.AbsolutePosition + (button.AbsoluteSize / 2)
    local s, inset = pcall(function() return GuiService:GetGuiInset() end)
    local insetY = s and inset.Y or 0

    VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y + insetY, game)
    randomDelay(25, 60) 
    
    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + insetY, 0, true, game, 1)
    randomDelay(40, 110) 
    
    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + insetY, 0, false, game, 1)

    button.ZIndex = origZIndex
    if screenGui then screenGui.DisplayOrder = origDisplayOrder end

    return true
end

-- ========================================================================
-- 🛡️ PART 1: AUTO-CAPTCHA SYSTEM
-- ========================================================================
if getgenv().Config and getgenv().Config.AutoCaptcha then
    task.spawn(function()
        local CAPTCHA_CONFIG = { POLL_INTERVAL = 0.2, RETRY_DELAY = 1.0, CLICK_COOLDOWN = 0.8 }
        local Captcha = { Solving = false, Cache = {}, LastClick = 0 }

        local BUTTON_HASHES = {
            ["40d02d582d76f54881f5f000c9a3712d"] = "1", ["3da8772a1380df0ea9d6e29e584d0dfa"] = "2",
            ["2ca84bc6e12650e6a29b371030041c71"] = "3", ["5abb9a3e809ddf2abec6bad6c30b9357"] = "4",
            ["f2183de3439a29ca186a1085a254ee36"] = "5", ["469569cf140da51f1b78fc640eaf6682"] = "6",
            ["ce4d4f4d3bc8cba41ae0ba9955d052c2"] = "7", ["4dcc9cb4f28e200508ace4b493e8b5b7"] = "8",
            ["151fa826f05ded1c9903149d0c451a1c"] = "9", ["fda452a0b122c2b4230fc74e5135c3fc"] = "10",
            ["8b7bec3549554a512cdc2a993ce8f441"] = "11", ["988d2aba9e47d6cafced32dbac0256ab"] = "12",
            ["6a3723b695d9e6900f8fcc9106b64008"] = "13", ["af300da49b235a2ea90d62f17fcfe8c7"] = "14",
            ["fd6700a486a6ced004db4d1d5eb8e098"] = "15", ["63cb01f205f7edfabac4e7ab1eb7dc08"] = "RESET" 
        }

        local function checkFailedToLoad()
            local topCard = PlayerGui:FindFirstChild("CardCaptchaGame")
            if not topCard then return false end
            for _, v in pairs(topCard:GetDescendants()) do
                if v:IsA("TextLabel") and string.find(string.lower(v.Text), "failed to load") then return true end
            end
            return false
        end

        local function captchaVisible()
            local captchaGame = safeFind(PlayerGui, "CardCaptchaGame", "CaptchaGame")
            return captchaGame and captchaGame.Visible or false
        end

        local function getTargetId()
            local topCard = PlayerGui:FindFirstChild("CardCaptchaGame")
            if not topCard or (topCard.Enabled == false) then return nil end
            local card = safeFind(topCard, "CaptchaGame", "Top", "Card")
            if not card then return nil end
            return string.match(card.Image, "id=(%d+)")
        end

        local function getButtonFromAPI(assetId)
            if not makeHttpRequest then return nil end
            local apiUrl = "https://thumbnails.roproxy.com/v1/assets?assetIds=" .. assetId .. "&returnPolicy=PlaceHolder&size=420x420&format=Webp"
            local success, response
            for i = 1, 2 do
                success, response = pcall(function() return makeHttpRequest({ Url = apiUrl, Method = "GET" }) end)
                if success and response and response.StatusCode == 200 then break end
                task.wait(0.5)
            end
            if not (success and response and response.StatusCode == 200) then return nil end
            local dataSuccess, decodedData = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if dataSuccess and decodedData and decodedData.data and #decodedData.data > 0 then
                local imageUrl = decodedData.data[1].imageUrl or ""
                for savedHash, buttonNum in pairs(BUTTON_HASHES) do
                    if string.find(imageUrl, savedHash) then return buttonNum end
                end
            end
            return nil
        end

        local function getCachedButton(assetId)
            if Captcha.Cache[assetId] then return Captcha.Cache[assetId] end
            local btn = getButtonFromAPI(assetId)
            if btn then Captcha.Cache[assetId] = btn end
            return btn
        end

        local function clickCaptchaButton(buttonNumber)
            local buttons = safeFind(PlayerGui, "CardCaptchaGame", "CaptchaGame", "Bottom", "Buttons")
            if not buttons then return false end
            local btn = buttons:FindFirstChild(tostring(buttonNumber))
            return btn and SafeVIMClick(btn)
        end

        local function startSolveRoutine()
            if Captcha.Solving then return end
            Captcha.Solving = true
            getgenv().IsCaptchaActive = true
            task.spawn(function()
                while captchaVisible() do
                    if checkFailedToLoad() then LocalPlayer:Kick("Failed to load captcha.") break end
                    local asset = getTargetId()
                    if not asset then task.wait(CAPTCHA_CONFIG.POLL_INTERVAL) continue end
                    local now = tick()
                    if now - Captcha.LastClick < CAPTCHA_CONFIG.CLICK_COOLDOWN then task.wait(CAPTCHA_CONFIG.POLL_INTERVAL) continue end
                    
                    local button = getCachedButton(asset)
                    if not button or button == "RESET" then button = tostring(math.random(1, 15)) end
                    
                    clickCaptchaButton(button)
                    Captcha.LastClick = tick()
                    task.wait(CAPTCHA_CONFIG.RETRY_DELAY)
                end
                Captcha.Solving = false
                getgenv().IsCaptchaActive = false
            end)
        end

        local cardCaptchaUI = PlayerGui:WaitForChild("CardCaptchaGame", 10)
        if cardCaptchaUI then
            local captchaGameFrame = cardCaptchaUI:WaitForChild("CaptchaGame", 10)
            if captchaGameFrame then
                captchaGameFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                    if captchaGameFrame.Visible then startSolveRoutine() end
                end)
            end
        end
        if captchaVisible() then startSolveRoutine() end
    end)
end

