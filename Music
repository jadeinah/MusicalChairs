local function safeFind(parent, ...)
    local current = parent
    for _, name in ipairs({...}) do
        current = current and current:FindFirstChild(name)
        if not current then return nil end
    end
    return current
end

-- ==========================================
-- 🖱️ HUMANIZED VIM CLICKER & HELPERS
-- ==========================================
local function randomDelay(minMs, maxMs)
    task.wait(math.random(minMs, maxMs) / 1000)
end

local function SafeVIMClick(button)
    if not button then return false end
    
    local screenGui = button:FindFirstAncestorWhichIsA("ScreenGui")
    local origDisplayOrder = screenGui and screenGui.DisplayOrder or 0
    local origZIndex = button.ZIndex

    if screenGui then screenGui.DisplayOrder = 999999 end
    button.ZIndex = 999999

    local pos = button.AbsolutePosition + (button.AbsoluteSize / 2)
    local s, inset = pcall(function() return GuiService:GetGuiInset() end)
    local insetY = s and inset.Y or 0

    VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y + insetY, game)
    randomDelay(25, 60) 
    
    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + insetY, 0, true, game, 1)
    randomDelay(40, 110) 
    
    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + insetY, 0, false, game, 1)

    button.ZIndex = origZIndex
    if screenGui then screenGui.DisplayOrder = origDisplayOrder end

    return true
end

