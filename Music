-- ========================================================================
-- 🪑 PART 3: MUSICAL CHAIRS BOT & HANDSHAKE
-- ========================================================================
if getgenv().Config.AutoMusicalChairs then

    -- Game Start Handshake Call (Humanized Delay)
    task.spawn(function()
        task.wait(math.random(300, 650) / 100)
        pcall(function()
            local Event = ReplicatedStorage:WaitForChild("MusicalChairs", 5):WaitForChild("GameStartHandshake", 5)
            if Event then Event:FireServer(true) end
        end)
    end)

    -- Player & Character Setup
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")

    local isTargetingSeat = false
    local musicPlaying = false
    local isEliminated = false
    local activeRamp = nil

    -- Anti-AFK
    LocalPlayer.Idled:Connect(function()
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button2Down(Vector2.new(0, 0))
            task.wait(0.1)
            VirtualUser:Button2Up(Vector2.new(0, 0))
        end)
    end)

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        character = newChar
        humanoid = character:WaitForChild("Humanoid")
        hrp = character:WaitForChild("HumanoidRootPart")
        isEliminated = false 
    end)

    -- Seat Finder
    local function getRandomClosestSeat()
        local availableSeats = {}
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item.Name == "GameSeat" and (item:IsA("Seat") or item:IsA("VehicleSeat")) then
                if item.Occupant == nil and not item.Disabled then
                    local dist = (hrp.Position - item.Position).Magnitude
                    table.insert(availableSeats, {seat = item, distance = dist})
                end
            end
        end

        if #availableSeats == 0 then return nil end

        table.sort(availableSeats, function(a, b) return a.distance < b.distance end)

        local maxChoices = math.min(3, #availableSeats) 
        return availableSeats[math.random(1, maxChoices)].seat
    end

    -- Obstacle & Ramp Mechanics
    local function hasOverheadObstacle(targetPart)
        local rayOrigin = targetPart.Position
        local rayDirection = Vector3.new(0, 6, 0)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character, targetPart}
        if activeRamp then table.insert(raycastParams.FilterDescendantsInstances, activeRamp) end
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        return Workspace:Raycast(rayOrigin, rayDirection, raycastParams) ~= nil
    end

    local function removeTemporaryRamp()
        if activeRamp then
            activeRamp:Destroy()
            activeRamp = nil
        end
    end

    local function createTemporaryRamp(targetPos)
        removeTemporaryRamp()
        local p1 = hrp.Position - Vector3.new(0, 3, 0)
        local p2 = targetPos + Vector3.new(0, 0.5, 0)
        local distance = (p1 - p2).Magnitude

        activeRamp = Instance.new("Part")
        activeRamp.Name = "BotStairs"
        activeRamp.Anchored = true
        activeRamp.CanCollide = true
        activeRamp.Transparency = 1 
        activeRamp.Size = Vector3.new(4, 1, distance)
        activeRamp.CFrame = CFrame.lookAt(p1:Lerp(p2, 0.5), p2)
        activeRamp.Parent = Workspace
    end

    -- Navigation Logic
    local function goToSeat()
        if isEliminated or isTargetingSeat or humanoid.Sit or getgenv().IsCaptchaActive then return end
        
        local targetSeat = getRandomClosestSeat()
        if not targetSeat then return end

        isTargetingSeat = true
        local isBlockedAbove = hasOverheadObstacle(targetSeat)
        local pathTarget = targetSeat.Position
        if isBlockedAbove then
            pathTarget = (targetSeat.CFrame * CFrame.new(0, 0, -3)).Position 
        end

        local path = PathfindingService:CreatePath({
            AgentRadius = 1.5,
            AgentHeight = 4.5,
            AgentCanJump = true,
            WaypointSpacing = 2
        })

        local success, _ = pcall(function() path:ComputeAsync(hrp.Position, pathTarget) end)

        if success and path.Status == Enum.PathStatus.Success then
            for _, waypoint in ipairs(path:GetWaypoints()) do
                if targetSeat.Occupant ~= nil or humanoid.Sit or isEliminated or getgenv().IsCaptchaActive then
                    isTargetingSeat = false
                    return
                end

                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    local distToSeat = (hrp.Position - targetSeat.Position).Magnitude
                    if not (isBlockedAbove and distToSeat < 8) then humanoid.Jump = true end
                end

                -- Humanized Waypoint Jitter Offset
                local jitterX = math.random(-15, 15) / 10
                local jitterZ = math.random(-15, 15) / 10
                local humanizedPosition = Vector3.new(
                    waypoint.Position.X + jitterX,
                    waypoint.Position.Y,
                    waypoint.Position.Z + jitterZ
                )

                humanoid:MoveTo(humanizedPosition)

                local timeout = os.clock()
                while (os.clock() - timeout) < 1.2 do
                    local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(humanizedPosition.X, 0, humanizedPosition.X)).Magnitude
                    if dist < 2 or humanoid.Sit then break end
                    
                    if hrp.AssemblyLinearVelocity.Magnitude < 0.5 then
                        local distToSeat = (hrp.Position - targetSeat.Position).Magnitude
                        if not (isBlockedAbove and distToSeat < 8) then humanoid.Jump = true end
                    end
                    RunService.Heartbeat:Wait()
                end
            end
        end

        -- Final Approach
        if targetSeat.Occupant == nil and not humanoid.Sit and not isEliminated and not getgenv().IsCaptchaActive then
            if not isBlockedAbove then createTemporaryRamp(targetSeat.Position) end
            
            local seatTimeout = os.clock()
            local stuckTimer = 0
            
            while not humanoid.Sit and targetSeat.Occupant == nil and not isEliminated and (os.clock() - seatTimeout) < 3 do
                humanoid:MoveTo(targetSeat.Position)
                
                if hrp.AssemblyLinearVelocity.Magnitude < 0.5 then
                    stuckTimer += RunService.Heartbeat:Wait()
                    if not isBlockedAbove then
                        humanoid.Jump = true 
                    elseif stuckTimer > 0.5 then
                        local wiggle = Vector3.new(math.random(-2, 2), 0, math.random(-2, 2))
                        humanoid:MoveTo(targetSeat.Position + wiggle)
                        stuckTimer = 0
                    end
                else
                    stuckTimer = 0
                end
                RunService.Heartbeat:Wait()
            end
            removeTemporaryRamp()
        end

        isTargetingSeat = false
    end

    -- Remote Event Listeners
    local musicalFolder = ReplicatedStorage:WaitForChild("MusicalChairs", 5)
    if musicalFolder then
        local walkAnimEvent = musicalFolder:FindFirstChild("WalkAnim")
        if walkAnimEvent then
            walkAnimEvent.OnClientEvent:Connect(function(isWalking)
                musicPlaying = isWalking
                if not isWalking and not isEliminated then
                    task.spawn(goToSeat)
                end
            end)
        end

        local airplaneEvent = musicalFolder:FindFirstChild("Airplane")
        if airplaneEvent then
            airplaneEvent.OnClientEvent:Connect(function(playerNameString)
                if playerNameString and type(playerNameString) == "string" then
                    local lowerText = string.lower(playerNameString)
                    if string.find(lowerText, string.lower(LocalPlayer.Name)) or string.find(lowerText, string.lower(LocalPlayer.DisplayName)) then
                        isEliminated = true
                        isTargetingSeat = false
                        removeTemporaryRamp() 
                        if humanoid then humanoid:MoveTo(hrp.Position) end
                    end
                end
            end)
        end

        local resetSeatsEvent = musicalFolder:FindFirstChild("ResetSeats")
        if resetSeatsEvent then
            resetSeatsEvent.OnClientEvent:Connect(function()
                isEliminated = false
                isTargetingSeat = false
                removeTemporaryRamp()
            end)
        end
    end

    -- Fallback Loop
    task.spawn(function()
        while task.wait(0.2) do
            if not isEliminated and not musicPlaying and humanoid and not humanoid.Sit and not isTargetingSeat and not getgenv().IsCaptchaActive then
                local seat = getRandomClosestSeat()
                if seat then task.spawn(goToSeat) end
            end
        end
    end)

end -- End of AutoMusicalChairs Toggle
