-- ========================================================================
-- 🪑 PART 3: MUSICAL CHAIRS BOT (SMART PATHFINDING & OBSTACLE BYPASS)
-- ========================================================================
if getgenv().Config and getgenv().Config.AutoMusicalChairs then

    -- Handshake Call
    task.spawn(function()
        task.wait(math.random(300, 650) / 100)
        pcall(function()
            local Event = ReplicatedStorage:WaitForChild("MusicalChairs", 5):WaitForChild("GameStartHandshake", 5)
            if Event then Event:FireServer(true) end
        end)
    end)

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")

    local isTargetingSeat = false
    local musicPlaying = false
    local isEliminated = false
    local AssignedSeat = nil 

    -- Anti-AFK
    LocalPlayer.Idled:Connect(function()
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button2Down(Vector2.new(0, 0))
            task.wait(0.1); VirtualUser:Button2Up(Vector2.new(0, 0))
        end)
    end)

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        character = newChar
        humanoid = character:WaitForChild("Humanoid")
        hrp = character:WaitForChild("HumanoidRootPart")
        isEliminated = false 
        AssignedSeat = nil
    end)

    local function clearAllSeatTags()
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item.Name == "GameSeat" and item:GetAttribute("AssignedToBot") then
                item:SetAttribute("AssignedToBot", nil)
            end
        end
    end

    local function getAndAssignClosestSeat()
        local bestSeat = nil
        local shortestDist = math.huge
        local now = tick()

        for _, item in ipairs(Workspace:GetDescendants()) do
            if item.Name == "GameSeat" and (item:IsA("Seat") or item:IsA("VehicleSeat")) then
                local unreachableTime = item:GetAttribute("Unreachable")
                local isRecentUnreachable = unreachableTime and (now - unreachableTime < 8)

                if item.Occupant == nil and not item.Disabled and not item:GetAttribute("AssignedToBot") and not isRecentUnreachable then
                    local dist = (hrp.Position - item.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestSeat = item
                    end
                end
            end
        end

        if bestSeat then
            bestSeat:SetAttribute("AssignedToBot", true)
        end

        return bestSeat
    end

    -- 🌟 SMART PATHFINDING + ELEVATED JUMP & OBSTACLE BYPASS 🌟
    local function walkToSeatUsingPathfinding(targetSeat)
        if not targetSeat or not hrp or not humanoid then return false end

        -- 1. Compute Path (Pinaliit ang Radius para dumaan sa mga upuan, pillow, at table)
        local path = PathfindingService:CreatePath({
            AgentRadius = 1.2,
            AgentHeight = 4,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 2
        })

        local success = pcall(function()
            path:ComputeAsync(hrp.Position, targetSeat.Position)
        end)

        if not success or path.Status ~= Enum.PathStatus.Success then
            targetSeat:SetAttribute("Unreachable", tick())
            return false
        end

        local waypoints = path:GetWaypoints()

        for _, waypoint in ipairs(waypoints) do
            if targetSeat.Occupant ~= nil or isEliminated or humanoid.Sit or getgenv().IsCaptchaActive then
                return false
            end

            -- Elevated Check
            local horizDist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetSeat.Position.X, 0, targetSeat.Position.Z)).Magnitude
            local heightDiff = targetSeat.Position.Y - hrp.Position.Y

            if horizDist <= 7 and heightDiff > 1.8 then
                humanoid.Jump = true
            end

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            humanoid:MoveTo(waypoint.Position)

            local timeout = os.clock()
            local reached = false
            local conn
            
            conn = humanoid.MoveToFinished:Connect(function()
                reached = true
                if conn then conn:Disconnect() end
            end)

            local lastPos = hrp.Position

            -- Anti-Stuck habang naglalakad sa waypoint (Auto Spam Jump kapag nabara sa lapis/cabinet)
            while not reached and (os.clock() - timeout < 0.8) do
                if targetSeat.Occupant ~= nil or humanoid.Sit then break end
                
                local timeElapsed = os.clock() - timeout
                local movedDist = (hrp.Position - lastPos).Magnitude
                
                if timeElapsed > 0.3 and movedDist < 0.5 then
                    humanoid.Jump = true
                    humanoid:MoveTo(waypoint.Position)
                end
                
                lastPos = hrp.Position
                RunService.Heartbeat:Wait()
            end
            
            if conn then conn:Disconnect() end
        end

        -- Final Reach Check
        local finalHeight = targetSeat.Position.Y - hrp.Position.Y
        if finalHeight > 2 and not humanoid.Sit then
            humanoid.Jump = true
            humanoid:MoveTo(targetSeat.Position)
            task.wait(0.4)

            if not humanoid.Sit then
                targetSeat:SetAttribute("Unreachable", tick())
                return false
            end
        end

        return true
    end

    local function lockAndSit()
        if isEliminated or isTargetingSeat or humanoid.Sit or getgenv().IsCaptchaActive then return end
        isTargetingSeat = true

        while not humanoid.Sit and not isEliminated and not getgenv().IsCaptchaActive do
            clearAllSeatTags()
            AssignedSeat = getAndAssignClosestSeat()
            
            if not AssignedSeat then break end

            walkToSeatUsingPathfinding(AssignedSeat)
            
            RunService.Heartbeat:Wait()
        end

        AssignedSeat = nil
        isTargetingSeat = false
    end

    -- Remote Event Listeners
    local musicalFolder = ReplicatedStorage:WaitForChild("MusicalChairs", 5)
    if musicalFolder then
        local walkAnimEvent = musicalFolder:FindFirstChild("WalkAnim")
        if walkAnimEvent then
            walkAnimEvent.OnClientEvent:Connect(function(isWalking)
                musicPlaying = isWalking
                if not isWalking and not isEliminated then
                    task.spawn(lockAndSit)
                end
            end)
        end

        local airplaneEvent = musicalFolder:FindFirstChild("Airplane")
        if airplaneEvent then
            airplaneEvent.OnClientEvent:Connect(function(playerNameString)
                if playerNameString and type(playerNameString) == "string" then
                    local lowerText = string.lower(playerNameString)
                    if string.find(lowerText, string.lower(LocalPlayer.Name)) or string.find(lowerText, string.lower(LocalPlayer.DisplayName)) then
                        isEliminated = true
                        isTargetingSeat = false
                        clearAllSeatTags()
                        if AssignedSeat then AssignedSeat.CanCollide = true end
                        AssignedSeat = nil
                    end
                end
            end)
        end

        local resetSeatsEvent = musicalFolder:FindFirstChild("ResetSeats")
        if resetSeatsEvent then
            resetSeatsEvent.OnClientEvent:Connect(function()
                isEliminated = false
                isTargetingSeat = false
                clearAllSeatTags()
                AssignedSeat = nil
            end)
        end
    end

    task.spawn(function()
        while task.wait(0.05) do
            if not isEliminated and not musicPlaying and humanoid and not humanoid.Sit and not isTargetingSeat and not getgenv().IsCaptchaActive then
                task.spawn(lockAndSit)
            end
        end
    end)
end
